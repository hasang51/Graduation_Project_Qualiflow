ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
PDF_DPI=400
POPPLER_PATH=C:\poppler\Library\bin
DATABASE_URL=sqlite:///./data/qualiflow.db
STORAGE_DIR=./data/storage
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=240
REVIEW_CONFIDENCE_THRESHOLD=0.75
MAX_UPLOAD_MB=20
DEBUG_FIELD_PROVENANCE=0

# --- Optional: only for the offline OCR probe ---
# These variables are consumed exclusively by scripts/check_ocr_backend.py
# and app/services/ocr_service.py. The main extraction runtime does not
# require Tesseract or pytesseract.
# OCR_BACKEND=pytesseract
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_FAIL_LOUDLY=0
